{
  // ============================================================
  // profile：学位论文
  //   正文宋体小四、行距 20 磅、标题 1 / 1.1 / 1.1.1
  //   图表按章编号：图 2-1、表 2-1
  // ============================================================
  "name": "学位论文",

  "page": {
    "width_cm": 21.0,
    "height_cm": 29.7,
    "margin_cm": { "top": 3.0, "bottom": 2.5, "left": 3.0, "right": 2.5 },
    "header_distance_cm": 2.0,
    "footer_distance_cm": 1.75,
    "first_page_different": true
  },

  "doc_default": {
    "east_asia_font": "宋体",
    "ascii_font": "Times New Roman",
    "size_pt": "小四"
  },

  // ---------- 封面 ----------
  "cover": {
    "enabled": true,
    "top_space_cm": 7.0,
    "above": [],
    "below": ["XX 大学"],
    "bottom_space_cm": 1.5,
    "restyle": true,
    "page_number": false,
    "header": false
  },

  // ---------- 目录 & 前置部分（学位论文标配：目录 + 图目录 + 表目录） ----------
  "front_matter": {
    "toc_title": "目　录",
    "page_number": true,
    "page_num_fmt": "upperRoman",
    "page_num_start": 1,
    "header": false,
    "figures": { "enabled": true, "title": "图目录", "label": "图" },
    "tables":  { "enabled": true, "title": "表目录", "label": "表" }
  },

  // ---------- 正文页码 ----------
  "body_paging": { "page_num_fmt": "decimal", "page_num_start": 1 },

  "header": {
    // 偶数页页眉：设了才启用奇偶页不同（会因此每节从奇数页开始）
    "even_text": null,
    "text": "XX 大学硕士学位论文",
    "east_asia_font": "宋体",
    "ascii_font": "Times New Roman",
    "size_pt": "小五",
    "align": "center",
    "bottom_border": true
  },
  "footer": {
    "page_number": true,
    "format": "{PAGE}",
    "east_asia_font": "宋体",
    "ascii_font": "Times New Roman",
    "size_pt": "小五",
    "align": "center"
  },

  // 按章编号：图 2-1 / 表 2-1 / 式 (2-1)
  "captions": {
    "fig": "图 {n}",
    "tbl": "表 {n}",
    "eq": "({n})",
    "chapter": true
  },
  "caption_sep": "  ",

  "refs": {
    "fig": "{n}",
    "tbl": "{n}",
    "eq": "({n})",
    // {n} = 章号，{t} = 标题文字；写成 "第 {n} 节" 或 "「{t}」"
    "sec": "{n}"
  },

  // ---------- 参考文献 ----------
  //   md 头部写 bibliography: refs.bib 即可自动启用
  //   csl 可选：chinese-gb7714-2005-numeric（国标2005 数字）
  //              chinese-gb7714-2005-author-date（国标2005 作者-年）
  //              chinese-gb7714-1987-numeric（国标1987 数字）
  "citations": { "number_bibliography": true, "csl": "chinese-gb7714-2005-numeric" },

  // ---------- 宽表横排 ----------
  //   列出需要横排的表（按题注锚点名），这些表会单独放到横向页
  //   "landscape": ["tbl:wide"],
  "landscape": [],

  // ---------- 附录编号 ----------
  //   把附录的起点标题加锚点 {#sec:app}，之后的一级标题自动变成「附录 A / 附录 B」
  //   如果要回到正常章节编号，在那一节标题上加 {#sec:endappendix}
  "appendix": {
    "enabled": false,
    "label": "附录",
    "marker": "sec:app",
    "end_marker": "sec:endappendix"
  },

  // ---------- 摘要与关键词 ----------
  "abstract": {
    "enabled": true,
    "title": "摘　要",
    "title_style": "TOCHeading",
    "keywords_title": "关键词",
    "style": "Abstract"
  },

  // ---------- 脚注 / 尾注 ----------
  "notes": {
    "footnote": { "pos": "pageBottom", "num_fmt": "decimal",
                  "num_start": 1, "num_restart": "continuous" },
    "endnote":  { "pos": "docEnd", "num_fmt": "lowerRoman" }
  },

  // ---------- 列表 ----------
  "lists": {
    "ordered": { "num_fmt": "decimal", "format": "%1.", "indent_chars": 3 },
    "bullet": { "char": "•" }
  },

  // ---------- 文档级开关 ----------
  "document": {
    "track_changes": false,
    "protect": null,
    "default_tab_cm": 1.27,
    "zoom": 100
  },

  // ---------- 首字下沉 ----------
  "drop_cap": { "enabled": false, "lines": 3, "chars": 1 },

  "toc": {
    "auto": true,
    "tabs": true,          // 目录条目：层级缩进 + 右对齐点线制表位

    "levels": "1-3",
    "page_break_after": true
  },

  "heading_numbering": {
    "enabled": true,
    "east_asia_font": "宋体",
    "ascii_font": "Times New Roman",
    "bold": false,
    "levels": [
      { "format": "%1", "num_fmt": "decimal", "indent_chars": 0 },
      { "format": "%1.%2", "num_fmt": "decimal", "indent_chars": 0 },
      { "format": "%1.%2.%3", "num_fmt": "decimal", "indent_chars": 0 },
      { "format": "%1.%2.%3.%4", "num_fmt": "decimal", "indent_chars": 0 }
    ]
  },

  "table": {
    "preset": "three_line",
    "full_width": true,
    "cant_split": false,
    "borders": {
      "top": { "sz": 12 },
      "bottom": { "sz": 12 },
      "header_bottom": { "sz": 6 }
    },
    "header": {
      "bold": true,
      "repeat": true,
      "valign": "center",
      "shading": null,
      "align": "center"
    },
    "cell": { "valign": "center", "margin_twips": 108 }
  },

  "pretty_names": {
    "SourceCode": "Source Code"
  },

  "styles": {

    "CoverTitle": {
      "east_asia_font": "黑体", "size_pt": "小初", "align": "center",
      "space_before_pt": 0, "space_after_pt": 30, "line_spacing": 1.25
    },
    "CoverSubtitle": {
      "east_asia_font": "楷体", "size_pt": "三号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 72
    },
    "CoverAuthor": { "size_pt": "四号", "align": "center", "space_after_pt": 8 },
    "CoverDate":   { "size_pt": "四号", "align": "center", "space_after_pt": 8 },
    "CoverLine":   { "size_pt": "四号", "align": "center", "space_before_pt": 6, "space_after_pt": 6 },
    "Normal": {
      // 中文排版：孤行控制、按中文习惯控制首尾字符、标点可溢出边界、中英文自动间距
      "widow_control": true, "kinsoku": true, "overflow_punct": true,
      "auto_space_de": true, "auto_space_dn": true,
      "east_asia_font": "宋体", "ascii_font": "Times New Roman",
      "size_pt": "小四", "align": "justify",
      "line_spacing_pt": 20, "space_before_pt": 0, "space_after_pt": 0
    },
    "FirstParagraph": { "first_line_indent_chars": 2 },
    "BodyText": {
      "first_line_indent_chars": 2,
      "space_before_pt": 0, "space_after_pt": 0
    },
    // 表格单元格（与列表分开，可各自设字号）
    "TableText": {
      "size_pt": "五号", "first_line_indent_chars": 0,
      "line_spacing": 1.0, "space_before_pt": 2, "space_after_pt": 2
    },
    "Compact": {
      "size_pt": "五号", "first_line_indent_chars": 0,
      "space_before_pt": 0, "space_after_pt": 0, "line_spacing": 1.0
    },

    "Title": {
      "east_asia_font": "黑体", "size_pt": "二号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 24, "line_spacing": 1.5
    },
    "Subtitle": {
      "east_asia_font": "楷体", "size_pt": "三号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 12
    },
    "Author": { "align": "center", "space_after_pt": 6 },
    "Date":   { "align": "center", "space_after_pt": 12 },

    "Heading1": {
      "east_asia_font": "黑体", "size_pt": "三号", "align": "center",
      "space_before_pt": 18, "space_after_pt": 18, "line_spacing_pt": 24,
      "keep_next": true, "page_break_before": true
    },
    "Heading2": {
      "east_asia_font": "黑体", "size_pt": "四号", "align": "left",
      "space_before_pt": 12, "space_after_pt": 6, "line_spacing_pt": 22,
      "keep_next": true
    },
    "Heading3": {
      "east_asia_font": "黑体", "size_pt": "小四", "align": "left",
      "space_before_pt": 9, "space_after_pt": 6, "line_spacing_pt": 20,
      "keep_next": true
    },
    "Heading4": {
      "east_asia_font": "宋体", "size_pt": "小四", "bold": true, "align": "left",
      "space_before_pt": 6, "space_after_pt": 3, "keep_next": true
    },
    "Heading5": {
      "east_asia_font": "宋体", "size_pt": "小四", "bold": true, "align": "left",
      "space_before_pt": 6, "space_after_pt": 3, "keep_next": true
    },
    "Heading6": {
      "east_asia_font": "宋体", "size_pt": "小四", "bold": true, "align": "left",
      "space_before_pt": 6, "space_after_pt": 3, "keep_next": true
    },

    "Caption": {
      "bold": false,
      "east_asia_font": "宋体", "ascii_font": "Times New Roman",
      "size_pt": "五号", "align": "center", "first_line_indent_chars": 0,
      "space_before_pt": 3, "space_after_pt": 6, "line_spacing": 1.0
    },
    "ImageCaption": { "align": "center", "first_line_indent_chars": 0,
                      "space_before_pt": 6, "space_after_pt": 14 },
    "TableCaption": { "align": "center", "first_line_indent_chars": 0, "keep_next": true,
                      "space_before_pt": 12, "space_after_pt": 4 },
    "Figure":          { "align": "center", "first_line_indent_chars": 0, "keep_next": true, "line_spacing": 1.0 },
    "CaptionedFigure": { "align": "center", "first_line_indent_chars": 0, "keep_next": true, "line_spacing": 1.0 },

    "BlockText": {
      "east_asia_font": "楷体", "size_pt": "小四",
      "left_indent_chars": 2, "right_indent_chars": 2,
      "first_line_indent_chars": 0, "line_spacing": 1.5,
      "space_before_pt": 6, "space_after_pt": 6
    },
    "SourceCode": {
      "east_asia_font": "宋体", "ascii_font": "Consolas",
      "size_pt": "五号", "align": "left", "first_line_indent_chars": 0,
      "left_indent_chars": 1, "right_indent_chars": 1,
      "line_spacing": 1.0, "space_before_pt": 0, "space_after_pt": 0,
      "shading": "F6F6F6", "left_border_sz": 18
    },
    "FootnoteText": { "size_pt": "小五", "line_spacing": 1.0, "first_line_indent_chars": 0 },
    "TOC1": { "size_pt": "小四", "bold": true, "space_before_pt": 6, "space_after_pt": 0 },
    "TOC2": { "size_pt": "小四", "space_before_pt": 0, "space_after_pt": 0 },
    "TOC3": { "size_pt": "小四", "space_before_pt": 0, "space_after_pt": 0 },
    "TOC1": { "size_pt": "小四", "bold": true, "space_before_pt": 6, "space_after_pt": 0 },
    "TOC2": { "size_pt": "小四", "space_before_pt": 0, "space_after_pt": 0 },
    "TOC3": { "size_pt": "小四", "space_before_pt": 0, "space_after_pt": 0 },
    "TOCHeading": {
      "east_asia_font": "黑体", "size_pt": "三号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 18
    },
    "Bibliography": { "size_pt": "五号", "first_line_indent_chars": 0,
                      "hanging_indent_chars": 2, "line_spacing": 1.25, "align": "left" },
    "DefinitionTerm": { "size_pt": "小四", "bold": true, "first_line_indent_chars": 0 }
  }
}
