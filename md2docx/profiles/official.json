{
  // ============================================================
  // profile：党政机关公文（GB/T 9704 风格）
  //   正文仿宋三号、行距固定 28.8 磅、首行缩进 2 字符
  //   标题编号：一、 / （一） / 1. / （1）
  // ============================================================
  "name": "公文",

  "page": {
    "width_cm": 21.0,
    "height_cm": 29.7,
    "margin_cm": { "top": 3.7, "bottom": 3.5, "left": 2.8, "right": 2.6 },
    "header_distance_cm": 1.5,
    "footer_distance_cm": 2.8,
    "first_page_different": false
  },

  "doc_default": {
    "east_asia_font": "仿宋",
    "ascii_font": "Times New Roman",
    "size_pt": "三号"
  },

  // 公文一般不用页眉
  // ---------- 封面（公文通常不要单独封面，需要时把 enabled 改成 true） ----------
  "cover": {
    "enabled": false,
    "top_space_cm": 6.5,
    "above": [],
    "below": [],
    "bottom_space_cm": 2.0,
    // 封面 logo（相对 md 的路径），宽度按厘米；logo_bottom 放页面底部
    "logo": null,
    "logo_width_cm": 4.0,
    "logo_bottom": null,
    "logo_bottom_width_cm": 3.0,
    "restyle": true,
    "page_number": false,
    "header": false
  },

  // ---------- 目录 & 前置部分 ----------
  "front_matter": {
    "toc_title": "目　录",
    "page_number": true,
    "page_num_fmt": "decimal",
    "page_num_start": 1,
    "header": false,
    "figures": { "enabled": false, "title": "图目录", "label": "图" },
    "tables":  { "enabled": false, "title": "表目录", "label": "表" }
  },

  // ---------- 正文页码 ----------
  "body_paging": { "page_num_fmt": "decimal", "page_num_start": 1 },

  "header": {
    // 偶数页页眉：设了才启用奇偶页不同（会因此每节从奇数页开始）
    "even_text": null,
    "text": "",
    "size_pt": "小五",
    "align": "center",
    "bottom_border": false
  },
  "footer": {
    "page_number": true,
    "format": "— {PAGE} —",
    "east_asia_font": "宋体",
    "ascii_font": "Times New Roman",
    "size_pt": "小四",
    "align": "center"
  },

  "captions": {
    "fig": "图 {n}",
    "tbl": "表 {n}",
    "eq": "（{n}）",
    "chapter": false
  },
  "caption_sep": "  ",

  "refs": {
    "fig": "{n}",
    "tbl": "{n}",
    "eq": "（{n}）",
    // {n} = 章号，{t} = 标题文字
    "sec": "{n}"
  },

  // ---------- 参考文献 ----------
  //   md 头部写 bibliography: refs.bib 即可自动启用
  //   csl 可选：chinese-gb7714-2005-numeric（国标2005 数字）
  //              chinese-gb7714-2005-author-date（国标2005 作者-年）
  //              chinese-gb7714-1987-numeric（国标1987 数字）
  "citations": { "number_bibliography": true, "csl": "chinese-gb7714-2005-numeric" },

  // ---------- 宽表横排 ----------
  //   列出需要横排的表（按题注锚点名），这些表会单独放到横向页
  //   "landscape": ["tbl:wide"],
  "landscape": [],

  // ---------- 附录编号 ----------
  //   把附录的起点标题加锚点 {#sec:app}，之后的一级标题自动变成「附录 A / 附录 B」
  //   如果要回到正常章节编号，在那一节标题上加 {#sec:endappendix}
  "appendix": {
    "enabled": false,
    "label": "附录",
    "marker": "sec:app",
    "end_marker": "sec:endappendix"
  },

  // ---------- 摘要与关键词 ----------
  "abstract": {
    "enabled": true,
    "title": "摘　要",
    "title_style": "TOCHeading",
    "keywords_title": "关键词",
    "style": "Abstract"
  },

  // ---------- 脚注 / 尾注 ----------
  "notes": {
    "footnote": { "pos": "pageBottom", "num_fmt": "decimal",
                  "num_start": 1, "num_restart": "continuous" },
    "endnote":  { "pos": "docEnd", "num_fmt": "lowerRoman" }
  },

  // ---------- 列表 ----------
  "lists": {
    "ordered": { "num_fmt": "decimal", "format": "%1.", "indent_chars": 3 },
    "bullet": { "char": "•" }
  },

  // ---------- 文档级开关 ----------
  "document": {
    "track_changes": false,
    "protect": null,
    "default_tab_cm": 1.27,
    "zoom": 100
  },

  // ---------- 首字下沉 ----------
  "drop_cap": { "enabled": false, "lines": 3, "chars": 1 },

  "toc": {
    "auto": false,
    "levels": "1-2",
    "page_break_after": true
  },

  // 公文标题编号：一、 （一） 1. （1）
  "heading_numbering": {
    "enabled": true,
    "east_asia_font": "黑体",
    "ascii_font": "Times New Roman",
    "bold": false,
    "levels": [
      { "format": "%1、", "num_fmt": "chineseCounting", "indent_chars": 2 },
      { "format": "（%2）", "num_fmt": "chineseCounting", "indent_chars": 2 },
      { "format": "%3.", "num_fmt": "decimal", "indent_chars": 2 },
      { "format": "（%4）", "num_fmt": "decimal", "indent_chars": 2 }
    ]
  },

  "table": {
    "preset": "full_grid",
    "full_width": true,
    "cant_split": false,
    "borders": {},
    "header": {
      "bold": true,
      "repeat": true,
      "valign": "center",
      "shading": "F2F2F2",
      "align": "center"
    },
    "cell": { "valign": "center", "margin_twips": 108 }
  },

  "pretty_names": {
    "SourceCode": "Source Code"
  },

  "styles": {

    "CoverTitle": {
      "east_asia_font": "方正小标宋简体", "size_pt": "一号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 36, "line_spacing_pt": 44
    },
    "CoverSubtitle": {
      "east_asia_font": "楷体", "size_pt": "三号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 48
    },
    "CoverAuthor": { "east_asia_font": "仿宋", "size_pt": "三号", "align": "center", "space_after_pt": 8 },
    "CoverDate":   { "east_asia_font": "仿宋", "size_pt": "三号", "align": "center", "space_after_pt": 8 },
    "CoverLine":   { "east_asia_font": "仿宋", "size_pt": "三号", "align": "center", "space_before_pt": 6, "space_after_pt": 6 },
    "Normal": {
      // 中文排版：孤行控制、按中文习惯控制首尾字符、标点可溢出边界、中英文自动间距
      "widow_control": true, "kinsoku": true, "overflow_punct": true,
      "auto_space_de": true, "auto_space_dn": true,
      "east_asia_font": "仿宋", "ascii_font": "Times New Roman",
      "size_pt": "三号", "align": "justify",
      "line_spacing_pt": 28.8, "space_before_pt": 0, "space_after_pt": 0
    },
    "FirstParagraph": { "first_line_indent_chars": 2 },
    "BodyText": {
      "first_line_indent_chars": 2,
      "space_before_pt": 0, "space_after_pt": 0
    },
    // 表格单元格（与列表分开，可各自设字号）
    "TableText": {
      "size_pt": "五号", "first_line_indent_chars": 0,
      "line_spacing": 1.0, "space_before_pt": 2, "space_after_pt": 2
    },
    "Compact": {
      "size_pt": "四号", "first_line_indent_chars": 0,
      "space_before_pt": 0, "space_after_pt": 0, "line_spacing_pt": 24
    },

    "Title": {
      "east_asia_font": "方正小标宋简体", "size_pt": "二号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 24, "line_spacing_pt": 36
    },
    "Subtitle": {
      "east_asia_font": "楷体", "size_pt": "三号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 12
    },
    "Author": { "align": "center", "space_after_pt": 0 },
    "Date":   { "align": "center", "space_after_pt": 12 },

    // 公文标题：一级黑体、二级楷体、三级仿宋加粗，都顶格+缩进 2 字符
    "Heading1": {
      "east_asia_font": "黑体", "size_pt": "三号", "align": "left",
      "first_line_indent_chars": 2,
      "space_before_pt": 0, "space_after_pt": 0, "line_spacing_pt": 28.8,
      "keep_next": true
    },
    "Heading2": {
      "east_asia_font": "楷体", "size_pt": "三号", "align": "left",
      "first_line_indent_chars": 2,
      "space_before_pt": 0, "space_after_pt": 0, "line_spacing_pt": 28.8,
      "keep_next": true
    },
    "Heading3": {
      "east_asia_font": "仿宋", "size_pt": "三号", "bold": true, "align": "left",
      "first_line_indent_chars": 2,
      "space_before_pt": 0, "space_after_pt": 0, "line_spacing_pt": 28.8,
      "keep_next": true
    },
    "Heading4": {
      "east_asia_font": "仿宋", "size_pt": "三号", "bold": true, "align": "left",
      "first_line_indent_chars": 2,
      "space_before_pt": 0, "space_after_pt": 0, "keep_next": true
    },
    "Heading5": {
      "east_asia_font": "仿宋", "size_pt": "三号", "bold": true, "align": "left",
      "first_line_indent_chars": 2, "space_before_pt": 0, "space_after_pt": 0
    },
    "Heading6": {
      "east_asia_font": "仿宋", "size_pt": "三号", "bold": true, "align": "left",
      "first_line_indent_chars": 2, "space_before_pt": 0, "space_after_pt": 0
    },

    "Caption": {
      "bold": false,
      "east_asia_font": "仿宋", "ascii_font": "Times New Roman",
      "size_pt": "小四", "align": "center", "first_line_indent_chars": 0,
      "space_before_pt": 3, "space_after_pt": 6, "line_spacing_pt": 20
    },
    "ImageCaption": { "align": "center", "first_line_indent_chars": 0,
                      "space_before_pt": 6, "space_after_pt": 12 },
    "TableCaption": { "align": "center", "first_line_indent_chars": 0, "keep_next": true,
                      "space_before_pt": 12, "space_after_pt": 4 },
    "Figure":          { "align": "center", "first_line_indent_chars": 0, "keep_next": true, "line_spacing": 1.0 },
    "CaptionedFigure": { "align": "center", "first_line_indent_chars": 0, "keep_next": true, "line_spacing": 1.0 },

    "BlockText": {
      "east_asia_font": "楷体", "size_pt": "三号",
      "left_indent_chars": 2, "right_indent_chars": 2,
      "first_line_indent_chars": 0, "line_spacing_pt": 28.8,
      "space_before_pt": 0, "space_after_pt": 0
    },
    "SourceCode": {
      "east_asia_font": "仿宋", "ascii_font": "Consolas",
      "size_pt": "五号", "align": "left", "first_line_indent_chars": 0,
      "left_indent_chars": 2, "right_indent_chars": 1,
      "line_spacing": 1.0, "space_before_pt": 6, "space_after_pt": 6
    },
    "FootnoteText": { "size_pt": "小五", "line_spacing": 1.0, "first_line_indent_chars": 0 },
    "TOC1": { "size_pt": "小四", "bold": true, "space_before_pt": 6, "space_after_pt": 0 },
    "TOC2": { "size_pt": "小四", "space_before_pt": 0, "space_after_pt": 0 },
    "TOC3": { "size_pt": "小四", "space_before_pt": 0, "space_after_pt": 0 },
    "TOC1": { "size_pt": "小四", "bold": true, "space_before_pt": 6, "space_after_pt": 0 },
    "TOC2": { "size_pt": "小四", "space_before_pt": 0, "space_after_pt": 0 },
    "TOC3": { "size_pt": "小四", "space_before_pt": 0, "space_after_pt": 0 },
    "TOCHeading": {
      "east_asia_font": "黑体", "size_pt": "三号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 12
    },
    "Bibliography": { "size_pt": "小四", "first_line_indent_chars": 0 },
    "DefinitionTerm": { "size_pt": "三号", "bold": true, "first_line_indent_chars": 0 }
  }
}
