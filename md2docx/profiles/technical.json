{
  // ============================================================
  // profile：技术报告  （默认档）
  // 换格式就复制这个文件改，然后在命令里 --profile 指定
  // 校验/生成问答：python3 configure.py --profile 名字
  // ============================================================
  "name": "技术报告",

  // ---------- 页面 ----------
  "page": {
    "width_cm": 21.0,
    "height_cm": 29.7,
    "margin_cm": { "top": 2.54, "bottom": 2.54, "left": 3.17, "right": 2.54 },
    "header_distance_cm": 1.5,
    "footer_distance_cm": 1.75,
    "first_page_different": true
  },

  "doc_default": {
    "east_asia_font": "宋体",
    "ascii_font": "Times New Roman",
    "size_pt": "小四"
  },

  // ============================================================
  // 封面
  //   above / below 是额外的行（放在标题块上/下方）
  //   标题、副标题、作者、日期来自 md 的 YAML 头
  // ============================================================
  "cover": {
    "enabled": true,
    "top_space_cm": 6.5,
    "above": [],
    "below": [],
    "bottom_space_cm": 2.0,
    // 封面 logo（相对 md 的路径），宽度按厘米；logo_bottom 放页面底部
    "logo": null,
    "logo_width_cm": 4.0,
    "logo_bottom": null,
    "logo_bottom_width_cm": 3.0,
    "restyle": true,
    "page_number": false,
    "header": false
  },

  // ---------- 目录 & 前置部分 ----------
  "front_matter": {
    "toc_title": "目　录",
    "page_number": true,
    "page_num_fmt": "upperRoman",
    "page_num_start": 1,
    "header": false,
    // 图少的时候图目录只是白占一页；需要时改成 true
    "figures": { "enabled": false, "title": "图目录", "label": "图" },
    "tables":  { "enabled": false, "title": "表目录", "label": "表" }
  },

  // ---------- 正文页码 ----------
  "body_paging": {
    "page_num_fmt": "decimal",
    "page_num_start": 1
  },

  // ---------- 页眉 / 页脚 ----------
  "header": {
    // 偶数页页眉：设了才启用奇偶页不同（会因此每节从奇数页开始）
    "even_text": null,
    "text": "XX 单位内部报告",
    "east_asia_font": "宋体",
    "ascii_font": "Times New Roman",
    "size_pt": "小五",
    "align": "center",
    "bottom_border": true
  },
  "footer": {
    "page_number": true,
    "format": "第 {PAGE} 页 共 {NUMPAGES} 页",
    "east_asia_font": "宋体",
    "ascii_font": "Times New Roman",
    "size_pt": "小五",
    "align": "center"
  },

  // ============================================================
  // 题注：图/表/公式 编号外面长什么样  {n} 代表自动编号
  //   想要「图 1」   -> "图 {n}"
  //   想要「图1-1」  -> "图 {n}" + "chapter": true（按章重新编号）
  //   想要「(1)」    -> "({n})"
  //   想要「Figure 1」-> "Figure {n}"
  // ============================================================
  "captions": {
    "fig": "图 {n}",
    "tbl": "表 {n}",
    "eq": "({n})",
    "chapter": false
  },
  "caption_sep": "  ",              // 编号和题注文字之间的分隔

  // ---------- 正文里的交叉引用长什么样 ----------
  //   @fig:arch -> "图 {n}" 则出现「图 1」；写成 "{n}" 则出现「1」
  // 默认只出编号，正文自己写「见图 @fig:x」→「见图 1」
  // 若想「见 @fig:x」→「见 图 1」，改成 "图 {n}"
  "refs": {
    "fig": "{n}",
    "tbl": "{n}",
    "eq": "({n})",
    // {n} = 章号，{t} = 标题文字；写成 "第 {n} 节" 或 "「{t}」"
    "sec": "{n}"
  },

  // ---------- 参考文献 ----------
  //   md 头部写 bibliography: refs.bib 即可自动启用
  //   csl 可选：chinese-gb7714-2005-numeric（国标2005 数字）
  //              chinese-gb7714-2005-author-date（国标2005 作者-年）
  //              chinese-gb7714-1987-numeric（国标1987 数字）
  "citations": { "number_bibliography": true, "csl": "chinese-gb7714-2005-numeric" },

  // ---------- 宽表横排 ----------
  //   列出需要横排的表（按题注锚点名），这些表会单独放到横向页
  //   "landscape": ["tbl:wide"],
  "landscape": [],

  // ---------- 附录编号 ----------
  //   把附录的起点标题加锚点 {#sec:app}，之后的一级标题自动变成「附录 A / 附录 B」
  //   如果要回到正常章节编号，在那一节标题上加 {#sec:endappendix}
  "appendix": {
    "enabled": false,
    "label": "附录",
    "marker": "sec:app",
    "end_marker": "sec:endappendix"
  },

  // ---------- 摘要与关键词 ----------
  //   md 头部写 abstract: |  ... 和 keywords: [甲, 乙] 即可
  "abstract": {
    "enabled": true,
    "title": "摘　要",
    "title_style": "TOCHeading",
    "keywords_title": "关键词",
    "style": "Abstract"
  },

  // ---------- 脚注 / 尾注 ----------
  //   pos: pageBottom（页底）| beneathText（正文下方）
  //   num_fmt: decimal | lowerRoman | upperRoman | chineseCounting | symbol
  //   num_restart: continuous（连续）| eachPage（每页重排）| eachSect（每节重排）
  "notes": {
    "footnote": { "pos": "pageBottom", "num_fmt": "decimal",
                  "num_start": 1, "num_restart": "continuous" },
    "endnote":  { "pos": "docEnd", "num_fmt": "lowerRoman" }
  },

  // ---------- 列表 ----------
  "lists": {
    "ordered": { "num_fmt": "decimal", "format": "%1.", "indent_chars": 3 },
    "bullet": { "char": "•" }
  },

  // ---------- 文档级开关 ----------
  "document": {
    "track_changes": false,     // 打开后接收者改文档会被记录为修订
    "protect": null,             // readOnly | comments | trackedChanges | forms
    "default_tab_cm": 1.27,
    "zoom": 100
  },

  // ---------- 首字下沉 ----------
  "drop_cap": { "enabled": false, "lines": 3, "chars": 1 },

  // ---------- 目录 ----------
  "toc": {
    "auto": true,
    "tabs": true,          // 目录条目：层级缩进 + 右对齐点线制表位
                   // md 里没写 {{TOC}} 也自动插一个
    "levels": "1-3",                // 目录显示到几级标题
    "page_break_after": true        // 目录后另起一页
  },

  // ============================================================
  // 标题自动编号（Word 多级列表，改顺序自动重排）
  //   format 里 %1 %2 %3 表示各级序号
  //   num_fmt: decimal | chineseCounting | chineseCountingThousand
  //            | upperRoman | lowerRoman | upperLetter | lowerLetter
  //   suffix: space | tab | nothing
  // ============================================================
  "heading_numbering": {
    "enabled": true,
    "east_asia_font": "宋体",
    "ascii_font": "Times New Roman",
    "bold": false,
    "levels": [
      { "format": "%1", "num_fmt": "decimal", "indent_chars": 0 },
      { "format": "%1.%2", "num_fmt": "decimal", "indent_chars": 0 },
      { "format": "%1.%2.%3", "num_fmt": "decimal", "indent_chars": 0 },
      { "format": "%1.%2.%3.%4", "num_fmt": "decimal", "indent_chars": 0 }
    ]
  },

  // ============================================================
  // 表格
  //   preset: three_line（三线表）| full_grid（全框线）| outline（只有外框）| none
  //   想自定义就在 borders 里覆盖任意一边：
  //     "top": {"sz": 12, "color": "000000", "val": "single"}
  //     val 可用: single | double | dotted | dashed | none
  //     sz 单位 1/8 磅：6 = 0.75 磅，12 = 1.5 磅
  //   header_bottom 是表头下面那条线（三线表的中线）
  // ============================================================
  "table": {
    "preset": "three_line",
    "full_width": true,
    "cant_split": false,
    "borders": {
      "top": { "sz": 12 },
      "bottom": { "sz": 12 },
      "header_bottom": { "sz": 6 }
    },
    "header": {
      "bold": true,
      "repeat": true,
      "valign": "center",
      "shading": null,               // 表头底色，如 "F2F2F2"
      "align": null
    },
    "cell": {
      "valign": "center",            // top | center | bottom
      "margin_twips": 108
    }
  },

  // ============================================================
  // 各样式明细（Word 样式名 -> 格式）
  // 可用字段：east_asia_font / ascii_font / size_pt / bold / color
  //          align（left|center|right|justify）
  //          first_line_indent_chars / left_indent_chars / right_indent_chars
  //          space_before_pt / space_after_pt / line_spacing
  //          keep_next / page_break_before / shading / left_border_sz
  // ============================================================
  "pretty_names": {
    "SourceCode": "Source Code",
    "CoverTitle": "Cover Title",
    "CoverSubtitle": "Cover Subtitle",
    "CoverAuthor": "Cover Author",
    "CoverDate": "Cover Date",
    "CoverLine": "Cover Line"
  },

  "styles": {

    "CoverTitle": {
      "east_asia_font": "黑体", "size_pt": "小一", "align": "center",
      "space_before_pt": 0, "space_after_pt": 18, "line_spacing": 1.2
    },
    "CoverSubtitle": {
      "east_asia_font": "黑体", "size_pt": "三号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 60
    },
    "CoverAuthor": { "size_pt": "四号", "align": "center", "space_after_pt": 8 },
    "CoverDate":   { "size_pt": "四号", "align": "center", "space_after_pt": 8 },
    "CoverLine":   { "size_pt": "四号", "align": "center", "space_before_pt": 6, "space_after_pt": 6 },
    "Normal": {
      // 中文排版：孤行控制、按中文习惯控制首尾字符、标点可溢出边界、中英文自动间距
      "widow_control": true, "kinsoku": true, "overflow_punct": true,
      "auto_space_de": true, "auto_space_dn": true,
      "east_asia_font": "宋体", "ascii_font": "Times New Roman",
      "size_pt": "小四", "align": "justify",
      "line_spacing": 1.5, "space_before_pt": 0, "space_after_pt": 0
    },
    "FirstParagraph": { "first_line_indent_chars": 2 },
    "BodyText": {
      "first_line_indent_chars": 2,
      "space_before_pt": 0, "space_after_pt": 0
    },
    // 表格单元格（与列表分开，可各自设字号）
    "TableText": {
      "size_pt": "五号", "first_line_indent_chars": 0,
      "line_spacing": 1.0, "space_before_pt": 2, "space_after_pt": 2
    },
    "Compact": {
      "size_pt": "五号", "first_line_indent_chars": 0,
      "space_before_pt": 0, "space_after_pt": 0, "line_spacing": 1.0
    },

    "Title": {
      "east_asia_font": "黑体", "size_pt": "二号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 18, "line_spacing": 1.5
    },
    "Subtitle": {
      "east_asia_font": "黑体", "size_pt": "四号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 12
    },
    "Author": { "align": "center", "space_after_pt": 6 },
    "Date":   { "align": "center", "space_after_pt": 12 },

    "Heading1": {
      "east_asia_font": "黑体", "size_pt": "三号", "align": "center",
      "space_before_pt": 18, "space_after_pt": 12, "line_spacing": 1.5,
      "keep_next": true
    },
    "Heading2": {
      "east_asia_font": "黑体", "size_pt": "四号", "align": "left",
      "space_before_pt": 12, "space_after_pt": 6, "line_spacing": 1.5,
      "keep_next": true
    },
    "Heading3": {
      "east_asia_font": "黑体", "size_pt": "小四", "align": "left",
      "space_before_pt": 9, "space_after_pt": 6, "line_spacing": 1.5,
      "keep_next": true
    },
    "Heading4": {
      "east_asia_font": "宋体", "size_pt": "小四", "bold": true, "align": "left",
      "space_before_pt": 6, "space_after_pt": 3, "line_spacing": 1.5,
      "keep_next": true
    },
    "Heading5": {
      "east_asia_font": "宋体", "size_pt": "小四", "bold": true, "align": "left",
      "space_before_pt": 6, "space_after_pt": 3, "keep_next": true
    },
    "Heading6": {
      "east_asia_font": "宋体", "size_pt": "小四", "bold": true, "align": "left",
      "space_before_pt": 6, "space_after_pt": 3, "keep_next": true
    },

    "Caption": {
      "bold": false,
      "east_asia_font": "宋体", "ascii_font": "Times New Roman",
      "size_pt": "五号", "align": "center", "first_line_indent_chars": 0,
      "space_before_pt": 3, "space_after_pt": 6, "line_spacing": 1.0
    },
    "ImageCaption": {
      "align": "center", "first_line_indent_chars": 0,
      "space_before_pt": 6, "space_after_pt": 14
    },
    "TableCaption": {
      "align": "center", "first_line_indent_chars": 0, "keep_next": true,
      "space_before_pt": 12, "space_after_pt": 4
    },
    "Figure":          { "align": "center", "first_line_indent_chars": 0, "keep_next": true, "line_spacing": 1.0 },
    "CaptionedFigure": { "align": "center", "first_line_indent_chars": 0, "keep_next": true, "line_spacing": 1.0 },

    "BlockText": {
      "east_asia_font": "楷体", "size_pt": "小四",
      "left_indent_chars": 2, "right_indent_chars": 2,
      "first_line_indent_chars": 0, "line_spacing": 1.5,
      "space_before_pt": 6, "space_after_pt": 6
    },
    "SourceCode": {
      "east_asia_font": "宋体", "ascii_font": "Consolas",
      "size_pt": "小五", "align": "left", "first_line_indent_chars": 0,
      "left_indent_chars": 1, "right_indent_chars": 1,
      "line_spacing": 1.0, "space_before_pt": 0, "space_after_pt": 0,
      "shading": "F6F6F6", "left_border_sz": 18
    },
    "FootnoteText": { "size_pt": "小五", "line_spacing": 1.0, "first_line_indent_chars": 0 },
    "TOC1": { "size_pt": "小四", "bold": true, "space_before_pt": 6, "space_after_pt": 0 },
    "TOC2": { "size_pt": "小四", "space_before_pt": 0, "space_after_pt": 0 },
    "TOC3": { "size_pt": "小四", "space_before_pt": 0, "space_after_pt": 0 },
    "TOCHeading": {
      "east_asia_font": "黑体", "size_pt": "四号", "align": "center",
      "space_before_pt": 0, "space_after_pt": 12
    },
    "Bibliography": { "size_pt": "五号", "first_line_indent_chars": 0,
                      "hanging_indent_chars": 2, "line_spacing": 1.25, "align": "left" },
    "DefinitionTerm": { "size_pt": "小四", "bold": true, "first_line_indent_chars": 0 }
  }
}
